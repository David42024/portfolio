PORT=4000
NODE_ENV=development

# Runtime y seed
DATABASE_URL=postgresql://usuario:clave@localhost:5432/portfolio-tests
# Session/directa para prisma migrate. Con Supabase usa el pooler 5432.
DIRECT_URL=postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres

REVALIDATE_SECRET=tu_secret_revalidate
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Resend (opcional para envio de emails desde /api/v1/contact)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=tu-correo@dominio.com
CONTACT_EMAIL_FROM="Portfolio <onboarding@resend.dev>"

# Rate limiting para /api/v1/contact (opcional)
CONTACT_RATE_LIMIT_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW=3600000

# Redis (opcional; vacio = la API degrada sin cache)
REDIS_URL=